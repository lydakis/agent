MAX_ROLE = 60
MAX_TASK = 32
MAX_TASKS = 128
MAX_NAME = 100
MAX_MIX = 8
MAX_START = 64
START_AGENTS = 4
BUDGET_PER_AGENT = 10_000_000
MAX_BUDGET_M = 1000
# The shares of a budget past which the swarm, and each working member, is told.
SPENT = (50, 65, 80)
SETUP_TIMEOUT = 600
NAME_TRIES = 9
HELPER_ROUNDS = 8
